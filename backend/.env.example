# Kopyalayıp .env yapın. Gerçek anahtarları ASLA commit etmeyin.
DATABASE_URL=postgresql+psycopg://snapfridge:snapfridge@localhost:5432/snapfridge
JWT_SECRET=change-me
# mock   = yapay zekâ çağrısı yok, her fotoğrafa aynı cevap (geliştirme/test)
# gemini = gerçek tanıma, ÜCRETSİZ anahtar: https://aistudio.google.com/apikey
# claude = gerçek tanıma, ücretli anahtar: https://console.anthropic.com
VISION_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CORS_ORIGINS=http://localhost:5173
